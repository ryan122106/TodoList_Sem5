<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- background color -->
    <solid android:color="#FFFFFF"/>

    <!-- rounded corners -->
    <corners android:radius="12dp"/>

    <!-- border (optional) -->
    <stroke
        android:width="1dp"
        android:color="#DDDDDD"/>

    <!-- padding inside box effect (optional) -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp"/>

</shape>